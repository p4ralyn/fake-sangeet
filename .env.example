# ── app ──────────────────────────────────────────────────────────────────
APP_ENV=dev
APP_BASE_URL=http://localhost:8000
LOG_LEVEL=INFO
# generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-dev-only-not-a-real-secret

# ── the one event ────────────────────────────────────────────────────────
EVENT_SLUG=dryrun
EVENT_NAME=Collab Night
EVENT_VENUE=Main Auditorium
EVENT_STARTS_AT=2026-11-14T18:00:00+05:30
EVENT_ENDS_AT=2026-11-14T23:30:00+05:30
EVENT_SEATS_TOTAL=150

# ── datastores (compose overrides host names) ────────────────────────────
DATABASE_URL=postgresql+asyncpg://unigate:unigate@postgres:5432/unigate
REDIS_URL=redis://redis:6379/0

# ── identity ─────────────────────────────────────────────────────────────
# dev    = impersonate any seeded NetID, no Azure/Google needed. REFUSED when APP_ENV=prod.
# entra  = real Microsoft Entra OIDC.
# google = real Google Workspace OIDC, restricted to GOOGLE_ALLOWED_DOMAIN.
AUTH_PROVIDER=dev
ALLOWED_DOMAINS=["university.edu"]
COOKIE_SECURE=false
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_ALLOWED_DOMAIN=snu.edu.in

# ── object storage ───────────────────────────────────────────────────────
STORAGE_BACKEND=local
STORAGE_BUCKET=unigate-local
# ENDPOINT is server-to-server (api container -> fake-gcs container, compose
# DNS name). PUBLIC is what gets handed to a browser, so it must resolve from
# the developer's machine, not just inside the compose network -- hence
# localhost here even though the two point at the same fake-gcs-server.
STORAGE_ENDPOINT_URL=http://fake-gcs:4443
STORAGE_PUBLIC_URL=http://localhost:4443

# ── email ────────────────────────────────────────────────────────────────
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USE_TLS=false
SMTP_FROM=unigate@localhost

# ── staff seed: NetIDs granted roles by scripts/seed.py ───────────────────
SEED_OWNER_NET_IDS=["pk944"]
SEED_ADMIN_NET_IDS=["zq204", "zq203", "pk944", "zq202", "zq205", "zq201"]
SEED_SECURITY_NET_IDS=[]

# ── Entra setup (the ONLY thing that needs a real cloud account) ──────────
# Azure Portal → App registrations → New registration
#   Redirect URI (Web): http://localhost:8000/auth/callback
#   Certificates & secrets → New client secret → copy into ENTRA_CLIENT_SECRET
#   Token configuration → add optional claim: email (ID token)
# Then set AUTH_PROVIDER=entra. Leave it as `dev` to work without Azure.

# ── Google Workspace setup (also needs a real cloud account) ──────────────
# Google Cloud Console → APIs & Services → Credentials
#   Create Credentials → OAuth client ID → Application type: Web application
#   Authorized redirect URI: http://localhost:8000/auth/callback
#   Copy the Client ID into GOOGLE_CLIENT_ID, the Client secret into
#   GOOGLE_CLIENT_SECRET
# OAuth consent screen → User type: Internal (restricts the consent screen to
#   the snu.edu.in Workspace) or External with the domain still enforced
#   server-side by the `hd` claim check in the Google provider
# GOOGLE_ALLOWED_DOMAIN must match the Workspace domain exactly (snu.edu.in);
#   it is checked against the `hd` claim inside the verified ID token, not just
#   passed as an authorize-time hint, so it is the real gate, not the consent
#   screen setting above.
# Then set AUTH_PROVIDER=google. Leave it as `dev` to work without Google.

# ── access core (M2) ─────────────────────────────────────────────────────
# Signs the QR on every pass (LLD-v1 10.1). No default on purpose: a missing
# key fails startup rather than silently signing passes with a guessable
# secret. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Rotating this invalidates every pass already issued.
PASS_SIGNING_KEY=
SCAN_DUPLICATE_WINDOW_SECONDS=10
SCAN_DECISION_TOKEN_TTL_SECONDS=60
